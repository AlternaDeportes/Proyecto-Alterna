# =============================================================================
# ALTERNA — Variables de entorno
# Copiar a .env.local y completar valores.
# Portable: mismas variables en Vercel, Neon, Railway, Docker o VPS.
# =============================================================================

# Entorno
NODE_ENV=development

# URL pública (producción: dominio real)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL — Neon (https://neon.tech)
# Formato: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Autenticación — Auth.js / NextAuth v5 (Módulo autenticacion)
# Generar secret: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Emails que reciben rol ADMIN al ingresar (coma-separados)
ADMIN_EMAILS=
# Opcional en producción si el host no se detecta solo:
# AUTH_URL=https://tu-dominio.com
# AUTH_TRUST_HOST=true

# Email (Módulo contacto)
EMAIL_FROM=hola@alterna.example.com
RESEND_API_KEY=

# Cloudinary — media (Fase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis — opcional, cache/rate-limit (Fase 3)
REDIS_URL=
