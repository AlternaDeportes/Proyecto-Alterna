# =============================================================================
# ALTERNA — Variables de entorno
# Copiar a .env.local y completar valores.
# Portable: mismas variables en Vercel, Neon, Railway, Docker o VPS.
# =============================================================================

# Entorno
NODE_ENV=development

# URL pública (producción: dominio real, NUNCA localhost en Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL — Neon (https://neon.tech)
# Formato: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Autenticación — Auth.js / NextAuth v5 (Módulo autenticacion)
# Generar secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Emails que reciben rol ADMIN al ingresar (coma-separados)
ADMIN_EMAILS=
# Emails que reciben rol MODERATOR (moderación de mapa, sin ser admin total)
MODERATOR_EMAILS=
# En Vercel (Production) usá el dominio real, no localhost:
# AUTH_URL=https://proyecto-alterna.vercel.app
# AUTH_TRUST_HOST=true
# Redirect URI en Google Cloud Console (cliente tipo «Aplicación web», habilitado):
# http://localhost:3000/api/auth/callback/google
# https://proyecto-alterna.vercel.app/api/auth/callback/google
# Orígenes JS: http://localhost:3000 y https://proyecto-alterna.vercel.app
# Si Google dice «OAuth client was disabled», el cliente está apagado: creá uno nuevo.

# Email (Módulo contacto)
EMAIL_FROM=alterna.transmedia@gmail.com
RESEND_API_KEY=

# Cloudinary — media (Fase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis — opcional, cache/rate-limit (Fase 3)
REDIS_URL=
